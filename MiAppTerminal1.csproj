<Project Sdk="Microsoft.NET.Sdk.Web"> <!-- 💡 Esto activa Microsoft.AspNetCore automáticamente -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Paquetes necesarios para la interfaz visual e interactiva en .NET 10 -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0-preview.1.25121.8" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.0.14" />
    
    <!-- Mantenemos tu regla de configuraciones appsettings -->
    <None Update="appsettings*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
