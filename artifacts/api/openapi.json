  },
  "components": {
    "schemas": {
      "ActualizarTareaRequest": {
        "required": [
          "nuevoTitulo",
          "nuevaDescripcion"
        ],
        "type": "object",
        "properties": {
          "nuevoTitulo": {
            "pattern": "\\S",
            "type": "string"
          },
          "nuevaDescripcion": {
            "type": "string"
          }
        }
      },
      "ApiErrorResponse": {
        "required": [
          "status",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "CrearTareaRequest": {
        "required": [
          "titulo",
          "descripcion",
          "nombreResponsable",
          "apellidoResponsable"
        ],
        "type": "object",
        "properties": {
          "titulo": {
            "pattern": "\\S",
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          },
          "nombreResponsable": {
            "pattern": "^(?=.*\\S)[a-zA-ZáéíóúÁÉÍÓÚñÑ\\s]+$",
            "type": "string"
          },
          "apellidoResponsable": {
            "pattern": "^(?=.*\\S)[a-zA-ZáéíóúÁÉÍÓÚñÑ\\s]+$",
            "type": "string"
          }
        }
      },
      "MensajeResponse": {
        "required": [
          "mensaje"
        ],
        "type": "object",
        "properties": {
          "mensaje": {
            "type": "string"
          }
        }
      },
      "TareaResponse": {
        "required": [
          "id",
          "titulo",
          "descripcion",
          "nombreResponsable",
          "apellidoResponsable",
          "estaCompletado"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "titulo": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          },
          "nombreResponsable": {
            "type": "string"
          },
          "apellidoResponsable": {
            "type": "string"
          },
          "estaCompletado": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Tareas"
    }
  ]
}